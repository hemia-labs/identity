{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "<rootDir>/backend/node_modules/ts-jest",
      {
        "tsconfig": "<rootDir>/test/backend/tsconfig.json"
      }
    ]
  },
  "roots": [
    "<rootDir>/test/backend/e2e"
  ],
  "modulePaths": [
    "<rootDir>/backend/node_modules"
  ]
}
