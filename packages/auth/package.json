{
  "name": "@hemia/auth",
  "version": "0.0.5",
  "description": "Cliente reutilizable de SSO OAuth/OIDC de Hemia: core en TS puro + adapter NestJS.",
  "license": "MIT",
  "author": "Hemia",
  "keywords": ["sso", "oauth", "oidc", "pkce", "jwks", "nestjs", "auth"],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "module": "./dist/core/index.mjs",
  "exports": {
    ".": {
      "import":  { "types": "./dist/core/index.d.mts", "default": "./dist/core/index.mjs" },
      "require": { "types": "./dist/core/index.d.ts",  "default": "./dist/core/index.js" }
    },
    "./nestjs": {
      "import":  { "types": "./dist/nestjs/index.d.mts", "default": "./dist/nestjs/index.mjs" },
      "require": { "types": "./dist/nestjs/index.d.ts",  "default": "./dist/nestjs/index.js" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test":  "bun test",
    "prepack": "npm run build"
  },
  "publishConfig": {
     "access": "public"
  },
  "dependencies": {
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@types/express": ">=4",
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@nestjs/core": { "optional": true },
    "@types/express": { "optional": true },
    "express": { "optional": true }
  }
}
