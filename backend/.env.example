# Replace every placeholder secret before seeding or deploying.
NODE_ENV=development
PORT=3000
# Optional explicit interface; local supervised profile uses ::1.
APP_BIND_HOST=
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5176,http://localhost:5178,http://localhost:5180,http://localhost:3019
APP_ISSUER=https://id.hemia.cloud
ID_FRONTEND_URL=http://localhost:5173
AUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hemia
DB_PASSWORD=<db-password>
DB_DATABASE=hemia_id
DB_SSL=false
DB_LOGGING=false
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_APP=Hemia ID

ACCESS_API_URL=http://localhost:3019
ACCESS_JWKS_URI=http://localhost:3019/.well-known/jwks.json
ACCESS_AUDIENCE=access-api

JWT_ACCESS_SECRET=<jwt-access-secret>
JWT_REFRESH_SECRET=<jwt-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_SECRET=<oauth-state-secret>

GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_ACCESS_TOKEN_MAX_AGE_SECONDS=900
COOKIE_REFRESH_TOKEN_MAX_AGE_SECONDS=2592000

SUPER_ADMIN_EMAIL=admin@hemia.cloud
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_FIRST_NAME=Hemia
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PASSWORD=<super-admin-password>

# Seed-only. En local se generan e imprimen si faltan; en producción son obligatorios.
# Reejecutar el seed conserva hashes existentes y no rota secretos.
OAUTH_CLIENT_SECRET_CONSOLE_IDENTITY_ADMIN=<oauth-client-secret-console-identity-admin>
OAUTH_CLIENT_SECRET_CONSOLE_ACCESS_ADMIN=<oauth-client-secret-console-access-admin>
OAUTH_CLIENT_SECRET_BILLING_LEGAL_SERVICE=<oauth-client-secret-billing-legal-service>
OAUTH_CLIENT_SECRET_LEGAL=<oauth-client-secret-legal>
OAUTH_CLIENT_SECRET_CONSOLE=<oauth-client-secret-console>
OAUTH_CLIENT_SECRET_BILLING=<oauth-client-secret-billing>
OAUTH_CLIENT_SECRET_DOCS=<oauth-client-secret-docs>
OAUTH_CLIENT_SECRET_ACCESS=<oauth-client-secret-access>
OAUTH_CLIENT_SECRET_HELPDESK=<oauth-client-secret-helpdesk>

JWKS_KEY_KID=local-dev-rs256
JWKS_PRIVATE_KEY_PATH=./secrets/jwks-private.pem

# Solo necesarios al crear estos clientes por primera vez.
OAUTH_CLIENT_SECRET_ACCESS_LEGAL_VALIDATOR=<oauth-client-secret-access-legal-validator>
OAUTH_CLIENT_SECRET_BALANZ_BILLING_SERVICE=<oauth-client-secret-balanz-billing-service>
OAUTH_CLIENT_SECRET_LEGAL_SERVICE_DEV=<oauth-client-secret-legal-service-dev>
