NODE_ENV=development
PORT=3000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3019
APP_ISSUER=https://id.hemia.cloud
ID_FRONTEND_URL=http://localhost:5173
AUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hemia
DB_PASSWORD=hemia
DB_DATABASE=hemia_id
DB_SSL=false
DB_LOGGING=false
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_APP=Hemia ID
# No aplica desde ADR-003: las invitaciones viven en Access.
# EMAIL_INVITATION_ACCEPT_URL=http://localhost:5173/invitations/accept

ACCESS_API_URL=http://localhost:3019
ACCESS_JWKS_URI=http://localhost:3019/.well-known/jwks.json
ACCESS_AUDIENCE=access-api

JWT_ACCESS_SECRET=dev_access_secret_change_me_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_SECRET=dev_oauth_state_secret_change_me_32_chars

GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=dummy_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_ACCESS_TOKEN_MAX_AGE_SECONDS=900
COOKIE_REFRESH_TOKEN_MAX_AGE_SECONDS=2592000

SUPER_ADMIN_EMAIL=admin@hemia.cloud
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_FIRST_NAME=Hemia
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PASSWORD=dummy_super_admin_password_123

# Seed-only. Obligatorios al crear cada cliente; reejecutar el seed no rota secretos.
OAUTH_CLIENT_SECRET_IDENTITY_ADMIN_SERVICE=change_me_identity_admin_service
OAUTH_CLIENT_SECRET_CONSOLE_IDENTITY_ADMIN=change_me_console_identity_admin
OAUTH_CLIENT_SECRET_CONSOLE_ACCESS_ADMIN=change_me_console_access_admin
OAUTH_CLIENT_SECRET_HORUS=change_me_horus
OAUTH_CLIENT_SECRET_LEGAL=change_me_legal
OAUTH_CLIENT_SECRET_CONSOLE=change_me_console
OAUTH_CLIENT_SECRET_BILLING=change_me_billing
OAUTH_CLIENT_SECRET_DOCS=change_me_docs
OAUTH_CLIENT_SECRET_ACCESS=change_me_access
OAUTH_CLIENT_SECRET_HELPDESK=change_me_helpdesk

# No aplica desde ADR-003/ADR-007: el bootstrap de acceso vive en Access.
# SEED_USER_EMAIL=admin@hemia.local
# SEED_USER_USERNAME=admin
# SEED_USER_FIRST_NAME=Admin
# SEED_USER_LAST_NAME=User
# SEED_USER_PASSWORD=Admin123!
# IDENTITY_SERVICE_CLIENT_SECRET=dummy_identity_service_client_secret

JWKS_KEY_KID=local-dev-rs256
JWKS_PRIVATE_KEY_PATH=./secrets/jwks-private.pem
