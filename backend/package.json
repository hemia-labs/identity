{
  "name": "backend",
  "version": "1.1.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --config .prettierrc --write \"src/**/*.ts\" \"../test/backend/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "cd .. && backend/node_modules/.bin/eslint --config backend/eslint.config.mjs \"backend/{src,apps,libs}/**/*.ts\" \"test/backend/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs -d data-source.ts",
    "migration:generate": "bun run typeorm migration:generate src/database/migrations/Migration",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cd .. && IDENTITY_ENV_FILE=/dev/null docker compose --env-file /dev/null build && python3 test/docker/smoke.py",
    "test:typecheck": "tsc --noEmit -p ../test/backend/tsconfig.json",
    "test:seed:docker": "bun run build && bash ../test/backend/integration/postgres.docker.sh seed-clients"
  },
  "dependencies": {
    "@hemia/email-sender": "^0.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "joi": "^18.2.1",
    "mjml": "^5.3.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "..",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "<rootDir>/backend/node_modules/ts-jest",
        {
          "tsconfig": "<rootDir>/test/backend/tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "backend/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/backend/coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test/backend/unit"
    ],
    "modulePaths": [
      "<rootDir>/backend/node_modules"
    ]
  }
}
