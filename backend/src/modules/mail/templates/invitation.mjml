<mjml>
  <mj-head>
    <mj-title><%= app %> | Invitacion</mj-title>
    <mj-preview><%= actorLabel %> <%= actionLabel %><% if (resourceName) { %> en <%= resourceName %><% } %>.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
      <mj-text color="#13245A" font-size="16px" line-height="24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button font-family="Inter, Arial, sans-serif" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width:480px) {
        .mobile-center div {
          text-align: center !important;
        }

        .mobile-full-width a {
          width: 100% !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F4F8FF" width="640px">
    <mj-wrapper
      background-color="#FFFFFF"
      border="1px solid #DDE8F7"
      border-radius="14px"
      padding="0"
    >
      <mj-section padding="24px 40px" border-bottom="1px solid #E5ECF7">
        <mj-column>
          <mj-table align="center" padding="0">
            <tr>
              <td
                style="
                  vertical-align: middle;
                  width: 38px;
                  height: 38px;
                  background: #071B7A;
                  border-radius: 9px;
                  text-align: center;
                "
              >
                <img
                  src="https://api.iconify.design/lucide:mail-check.svg?color=%23FFFFFF"
                  width="22"
                  height="22"
                  alt="<%= app %>"
                  style="display: inline-block; vertical-align: middle;"
                />
              </td>
              <td style="vertical-align: middle; padding-left: 12px;">
                <div style="font-size: 26px; line-height: 32px; color: #061A63;">
                  <strong><%= app %></strong>
                </div>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section padding="36px 40px 22px 40px">
        <mj-column width="28%" vertical-align="top">
          <mj-table padding="0">
            <tr>
              <td
                align="center"
                style="
                  width: 128px;
                  height: 128px;
                  background: #F1F6FF;
                  border-radius: 14px;
                  border: 1px solid #E4ECFA;
                "
              >
                <img
                  src="https://api.iconify.design/solar:users-group-rounded-bold.svg?color=%2388AAEF"
                  width="78"
                  height="78"
                  alt="Invitacion"
                  style="display: block; margin: 0 auto;"
                />
                <div style="height: 8px; line-height: 8px;">&nbsp;</div>
                <img
                  src="https://api.iconify.design/lucide:file-text.svg?color=%23075CFF"
                  width="34"
                  height="34"
                  alt="Recurso"
                  style="display: block; margin: 0 auto;"
                />
              </td>
            </tr>
          </mj-table>
        </mj-column>

        <mj-column width="72%" vertical-align="top">
          <mj-text
            css-class="mobile-center"
            padding="0 0 18px 24px"
            font-size="32px"
            line-height="38px"
            font-weight="800"
            color="#071B5F"
          >
            Te han invitado a colaborar
          </mj-text>

          <mj-text
            css-class="mobile-center"
            padding="0 0 0 24px"
            font-size="17px"
            line-height="27px"
            color="#273A72"
          >
            <strong><%= actorLabel %></strong> <%= actionLabel %><% if (resourceName) { %>
            en <strong>"<%= resourceName %>"</strong><% } %> desde <%= app %>.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="10px 40px 22px 40px">
        <mj-column>
          <mj-table padding="0">
            <tr>
              <td
                style="
                  border: 1px solid #D7E3F5;
                  border-radius: 10px;
                  padding: 20px 22px;
                  background: #FFFFFF;
                "
              >
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                  <% if (resourceName) { %>
                  <tr>
                    <td width="48" style="padding: 0 0 16px 0; vertical-align: middle;">
                      <img
                        src="https://api.iconify.design/lucide:building-2.svg?color=%23314577"
                        width="18"
                        height="18"
                        alt="Recurso"
                        style="display: block;"
                      />
                    </td>
                    <td style="padding: 0 0 16px 0; color: #26386D; font-size: 17px;">
                      Recurso:
                    </td>
                    <td style="padding: 0 0 16px 0; color: #071B5F; font-size: 17px; font-weight: 700;">
                      <%= resourceName %>
                    </td>
                  </tr>
                  <tr>
                    <td colspan="3" style="border-top: 1px solid #E1E9F6;"></td>
                  </tr>
                  <% } %>

                  <tr>
                    <td width="48" style="padding: 16px 0; vertical-align: middle;">
                      <img
                        src="https://api.iconify.design/lucide:user-round.svg?color=%23314577"
                        width="18"
                        height="18"
                        alt="Invita"
                        style="display: block;"
                      />
                    </td>
                    <td style="padding: 16px 0; color: #26386D; font-size: 17px;">
                      Invita:
                    </td>
                    <td style="padding: 16px 0; color: #071B5F; font-size: 17px; font-weight: 700;">
                      <%= actorLabel %>
                    </td>
                  </tr>

                  <tr>
                    <td colspan="3" style="border-top: 1px solid #E1E9F6;"></td>
                  </tr>

                  <tr>
                    <td width="48" style="padding: 16px 0 0 0; vertical-align: middle;">
                      <img
                        src="https://api.iconify.design/lucide:clock-3.svg?color=%23314577"
                        width="18"
                        height="18"
                        alt="Expira"
                        style="display: block;"
                      />
                    </td>
                    <td style="padding: 16px 0 0 0; color: #26386D; font-size: 17px;">
                      Expira:
                    </td>
                    <td style="padding: 16px 0 0 0; color: #071B5F; font-size: 17px; font-weight: 700;">
                      <%= expiresAt %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section padding="6px 40px 22px 40px">
        <mj-column>
          <mj-button
            href="<%= acceptUrl %>"
            background-color="#075CFF"
            color="#FFFFFF"
            border-radius="7px"
            font-size="18px"
            font-weight="700"
            line-height="22px"
            inner-padding="16px 24px"
            width="100%"
            padding="0"
            css-class="mobile-full-width"
          >
            Aceptar invitacion
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0 40px 34px 40px">
        <mj-column>
          <mj-table padding="0">
            <tr>
              <td width="42" style="vertical-align: middle;">
                <img
                  src="https://api.iconify.design/lucide:shield-check.svg?color=%23075CFF"
                  width="17"
                  height="17"
                  alt="Seguridad"
                  style="display: block;"
                />
              </td>
              <td style="vertical-align: middle; color: #5C6D9C; font-size: 15px; line-height: 23px;">
                Si no esperabas esta invitacion, puedes ignorar este correo. El enlace solo puede usarse para aceptar esta invitacion.
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section
        background-color="#FAFCFF"
        padding="24px 40px 28px 40px"
        border-top="1px solid #E5ECF7"
      >
        <mj-column>
          <mj-text
            align="center"
            padding="0 0 10px 0"
            color="#5C6D9C"
            font-size="14px"
            line-height="21px"
          >
            Este correo fue enviado por <strong><%= app %></strong> para <%= inviteeEmail %>.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
