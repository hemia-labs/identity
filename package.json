{
  "name": "hemia-id",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "bun --cwd frontend dev",
    "dev:backend": "bun --cwd backend start:dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test"
  }
}
