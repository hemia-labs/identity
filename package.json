{
  "name": "hemia-id",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "version:auth": "node scripts/version-auth.mjs",
    "dev:web": "bun --cwd frontend dev",
    "dev:api": "bun --cwd backend start:dev",
    "build": "bun --filter '*' build",
    "test": "bun run --cwd backend test && bun run --cwd packages/auth test && bun run --cwd frontend test --run && bun run test:release",
    "test:release": "node --test test/release/auth-release.test.mjs",
    "test:package": "bun run --cwd packages/auth build && node test/auth/package/built-nestjs.cjs",
    "test:tarball": "node test/auth/package/check-auth-tarball.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1"
  }
}
